
{
  "entities": {
    "BloodDriveOption": {
      "title": "BloodDriveOption",
      "description": "Lokasi dan jadwal event donor darah.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "locationName": { "type": "string" },
        "eventDate": { "type": "string", "format": "date" },
        "maxQuota": { "type": "number" },
        "currentRegistrations": { "type": "number" }
      },
      "required": ["id", "locationName", "eventDate", "maxQuota", "currentRegistrations"]
    },
    "ParticipantRegistration": {
      "title": "ParticipantRegistration",
      "description": "Data pendaftaran peserta donor darah.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "nik": { "type": "string" },
        "nipp": { "type": "string" },
        "unitKerja": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "bloodType": { "type": "string" },
        "category": { "type": "string", "enum": ["Pegawai KCI", "Umum"] },
        "eventSlotId": { "type": "string" },
        "registrationDate": { "type": "object" },
        "githubUserId": { "type": "string" },
        "locationName": { "type": "string" },
        "locationDate": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": ["Tidak Hadir", "Berhasil", "Tidak Berhasil"],
          "description": "Status kehadiran dan keberhasilan donor darah."
        }
      },
      "required": ["id", "fullName", "email", "category", "bloodType", "eventSlotId", "githubUserId"]
    },
    "ApiConfiguration": {
      "title": "ApiConfiguration",
      "description": "Konfigurasi kunci API pihak ketiga untuk layanan email dan whatsapp.",
      "type": "object",
      "properties": {
        "resendApiKey": { "type": "string" },
        "fonnteToken": { "type": "string" },
        "updatedAt": { "type": "object" },
        "updatedBy": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous"]
  },
  "firestore": {
    "/eventSlots/{slotId}": {
      "schema": "BloodDriveOption",
      "description": "Koleksi publik lokasi donor darah (sebelumnya bloodDriveOptions)."
    },
    "/users/{userId}/registrations/{registrationId}": {
      "schema": "ParticipantRegistration",
      "description": "Data pendaftaran milik masing-masing user."
    },
    "/roles_admin/{userId}": {
      "schema": "object",
      "description": "Daftar admin untuk akses dashboard."
    },
    "/settings/api": {
      "schema": "ApiConfiguration",
      "description": "Pengaturan kunci API global untuk sistem."
    }
  }
}
